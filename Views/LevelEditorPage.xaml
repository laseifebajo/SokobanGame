<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SokobanGame.Views.LevelEditorPage"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1a1a2e}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <Label Grid.Row="0" Text="Level Editor" FontSize="24" FontAttributes="Bold"
               Margin="10"
               TextColor="{AppThemeBinding Light=#2c3e50, Dark=White}"/>

        <!-- Tool Palette using ImageButtons -->
        <HorizontalStackLayout Grid.Row="1" Spacing="5" Padding="5"
                                HorizontalOptions="Center">
            <ImageButton x:Name="WallBtn" Source="wall.png" WidthRequest="50" HeightRequest="50"
                         BackgroundColor="Transparent"
                         Clicked="ToolSelected" CommandParameter="#"/>
            <ImageButton x:Name="FloorBtn" Source="ground.png" WidthRequest="50" HeightRequest="50"
                         BackgroundColor="Transparent"
                         Clicked="ToolSelected" CommandParameter=" "/>
            <ImageButton x:Name="PlayerBtn" Source="player.png" WidthRequest="50" HeightRequest="50"
                         BackgroundColor="Transparent"
                         Clicked="ToolSelected" CommandParameter="@"/>
            <ImageButton x:Name="BoxBtn" Source="box.png" WidthRequest="50" HeightRequest="50"
                         BackgroundColor="Transparent"
                         Clicked="ToolSelected" CommandParameter="$"/>
            <ImageButton x:Name="TargetBtn" Source="target.png" WidthRequest="50" HeightRequest="50"
                         BackgroundColor="Transparent"
                         Clicked="ToolSelected" CommandParameter="."/>
        </HorizontalStackLayout>

        <!-- Editor Grid -->
        <ScrollView Grid.Row="2">
            <Grid x:Name="EditorGrid" Margin="10"
                  HorizontalOptions="Center" VerticalOptions="Start"/>
        </ScrollView>

        <!-- Bottom buttons -->
        <HorizontalStackLayout Grid.Row="3" Spacing="10"
                                HorizontalOptions="Center" Padding="10">
            <Button Text="Grid Size" Clicked="OnGridSizeClicked"
                    WidthRequest="110" HeightRequest="45"/>
            <Button Text="▶ Test" Clicked="OnTestClicked"
                    WidthRequest="110" HeightRequest="45"
                    BackgroundColor="Green" TextColor="White"/>
            <Button x:Name="SaveBtn"
                    Text="💾 Save"
                    Clicked="OnSaveClicked"
                    WidthRequest="110" HeightRequest="45"
                    BackgroundColor="Navy" TextColor="White"
                    IsEnabled="False"/>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>