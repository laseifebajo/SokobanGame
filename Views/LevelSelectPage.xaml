<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SokobanGame.Views.LevelSelectPage"
             Title="Select Level"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1a1a2e}">

    <Grid RowDefinitions="Auto,*">

        <Label Grid.Row="0" Text="Select Level" FontSize="28" FontAttributes="Bold"
               Margin="20,20,20,10"
               TextColor="{AppThemeBinding Light=#2c3e50, Dark=White}"/>

        <CollectionView Grid.Row="1" x:Name="LevelsCollection"
                        SelectionMode="Single"
                        SelectionChanged="OnLevelSelected"
                        Margin="10">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="3"
                                 HorizontalItemSpacing="8" VerticalItemSpacing="8"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="{AppThemeBinding Light=#ecf0f1, Dark=#2c3e50}"
                           CornerRadius="12" Padding="10" HeightRequest="90">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="{Binding Name}" FontSize="11"
                                   FontAttributes="Bold" HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#2c3e50, Dark=White}"/>
                            <Label Text="✓" FontSize="24" TextColor="Green"
                                   HorizontalOptions="Center"
                                   IsVisible="{Binding IsCompleted}"/>
                            <Label Text="{Binding BestMovesText}" FontSize="10"
                                   TextColor="Gray" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>