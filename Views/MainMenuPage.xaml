<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SokobanGame.Views.MainMenuPage"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1a1a2e}">

    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">

        <Label Text="SOKOBAN" FontSize="48" FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="{AppThemeBinding Light=#2c3e50, Dark=White}"/>

        <Label Text="Push the boxes onto the targets!" FontSize="16"
               HorizontalOptions="Center"
               TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}"/>

        <Button Text="▶  Play" Clicked="OnPlayClicked"
                WidthRequest="200" HeightRequest="55"
                BackgroundColor="#3498db" TextColor="White" CornerRadius="28"/>

        <Button Text="🎨  Level Editor" Clicked="OnEditorClicked"
                WidthRequest="200" HeightRequest="55"
                BackgroundColor="#2ecc71" TextColor="White" CornerRadius="28"/>

        <Button Text="⚙  Settings" Clicked="OnSettingsClicked"
                WidthRequest="200" HeightRequest="55"
                BackgroundColor="#95a5a6" TextColor="White" CornerRadius="28"/>

    </VerticalStackLayout>
</ContentPage>