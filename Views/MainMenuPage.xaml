<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SokobanGame.Views.MainMenuPage"
             BackgroundColor="#1a1a2e">

    <Grid RowDefinitions="*,Auto,*">

        <!-- Logo section -->
        <VerticalStackLayout Grid.Row="0" VerticalOptions="End"
                             HorizontalOptions="Center" Spacing="10"
                             Padding="0,0,0,30">
            <Label Text="📦" FontSize="80" HorizontalOptions="Center"/>
            <Label Text="SOKOBAN" FontSize="52" FontAttributes="Bold"
                   HorizontalOptions="Center" TextColor="White"
                   CharacterSpacing="8"/>
            <Label Text="Push the boxes onto the targets"
                   FontSize="15" HorizontalOptions="Center"
                   TextColor="#7f8c8d"/>
        </VerticalStackLayout>

        <!-- Buttons -->
        <VerticalStackLayout Grid.Row="1" Spacing="15"
                             HorizontalOptions="Center">
            <Button Text="▶   Play" Clicked="OnPlayClicked"
                    WidthRequest="260" HeightRequest="58"
                    BackgroundColor="#3498db" TextColor="White"
                    CornerRadius="29" FontSize="18" FontAttributes="Bold"/>
            <Button Text="🎨   Level Editor" Clicked="OnEditorClicked"
                    WidthRequest="260" HeightRequest="58"
                    BackgroundColor="#2ecc71" TextColor="White"
                    CornerRadius="29" FontSize="18"/>
            <Button Text="⚙   Settings" Clicked="OnSettingsClicked"
                    WidthRequest="260" HeightRequest="58"
                    BackgroundColor="#34495e" TextColor="White"
                    CornerRadius="29" FontSize="18"/>
        </VerticalStackLayout>

        <!-- Footer -->
        <Label Grid.Row="2" Text="ATU Galway-Mayo — 2026"
               FontSize="12" TextColor="#4a4a6a"
               HorizontalOptions="Center" VerticalOptions="End"
               Margin="0,0,0,20"/>

    </Grid>
</ContentPage>