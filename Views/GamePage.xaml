<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SokobanGame.Views.GamePage"
             BackgroundColor="{AppThemeBinding Light=#1a1a2e, Dark=#0d0d1a}">

    <Grid RowDefinitions="60,*,80">

        <!-- Top bar -->
        <Grid Grid.Row="0" ColumnDefinitions="60,*,100"
              BackgroundColor="{AppThemeBinding Light=#16213e, Dark=#0d0d1a}"
              Padding="5,0">
            <Button Grid.Column="0" Text="←" Clicked="OnBackClicked"
                    FontSize="24" BackgroundColor="Transparent"
                    TextColor="White"/>
            <Label Grid.Column="1" x:Name="LevelNameLabel"
                   FontSize="18" FontAttributes="Bold"
                   VerticalOptions="Center" HorizontalOptions="Center"
                   TextColor="White"/>
            <Label Grid.Column="2" x:Name="MoveCountLabel"
                   Text="Moves: 0" FontSize="14"
                   VerticalOptions="Center" HorizontalOptions="Center"
                   TextColor="#3498db"/>
        </Grid>

        <!-- Game grid fills the whole middle section -->
        <ScrollView Grid.Row="1" HorizontalScrollBarVisibility="Never">
            <Grid x:Name="GameGrid"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  Margin="5"/>
        </ScrollView>

        <!-- Bottom bar -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*"
              BackgroundColor="{AppThemeBinding Light=#16213e, Dark=#0d0d1a}"
              Padding="20,10">
            <Button Grid.Column="0" Text="↩  Undo" Clicked="OnUndoClicked"
                    BackgroundColor="#3498db" TextColor="White"
                    CornerRadius="25" Margin="5,0"/>
            <Button Grid.Column="1" Text="↺  Reset" Clicked="OnResetClicked"
                    BackgroundColor="#e74c3c" TextColor="White"
                    CornerRadius="25" Margin="5,0"/>
        </Grid>

    </Grid>
</ContentPage>