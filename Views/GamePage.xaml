<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SokobanGame.Views.GamePage"
             BackgroundColor="{AppThemeBinding Light=#f5f5f5, Dark=#1a1a2e}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Top bar -->
        <HorizontalStackLayout Grid.Row="0" Padding="10" Spacing="10">
            <Button Text="←" Clicked="OnBackClicked" FontSize="20"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#2c3e50, Dark=White}"/>
            <Label x:Name="LevelNameLabel" FontSize="18" FontAttributes="Bold"
                   VerticalOptions="Center" HorizontalOptions="FillAndExpand"
                   TextColor="{AppThemeBinding Light=#2c3e50, Dark=White}"/>
            <Label x:Name="MoveCountLabel" Text="Moves: 0" FontSize="16"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=#2c3e50, Dark=White}"/>
        </HorizontalStackLayout>

        <!-- Game Grid -->
        <Grid x:Name="GameGrid" Grid.Row="1" Margin="10"
              HorizontalOptions="Center" VerticalOptions="Center"/>

        <!-- Bottom bar -->
        <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center"
                               Spacing="20" Padding="10">
            <Button Text="↩ Undo" Clicked="OnUndoClicked"
                    WidthRequest="120" HeightRequest="45"
                    BackgroundColor="#3498db" TextColor="White" CornerRadius="22"/>
            <Button Text="↺ Reset" Clicked="OnResetClicked"
                    WidthRequest="120" HeightRequest="45"
                    BackgroundColor="#e74c3c" TextColor="White" CornerRadius="22"/>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>